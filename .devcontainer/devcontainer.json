{
  "name": "soroban-resurrect",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "npm install -g npm@10.9.8 && npm ci",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Docs site (npm run docs:dev)" },
    "8000": { "label": "Local Soroban RPC (docker compose up)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "vitest.explorer"]
    }
  }
}
