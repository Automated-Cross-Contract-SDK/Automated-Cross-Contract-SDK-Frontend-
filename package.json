{
  "name": "soroban-resurrect",
  "version": "0.1.0",
  "keywords": [
    "soroban",
    "stellar",
    "cap-0066",
    "ttl",
    "restore",
    "smart-contracts",
    "wallet"
  ],
  "private": true,
  "description": "Automated Cross-Contract State Restoration SDK & Wallet Middleware for Soroban",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.8",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "scripts": {
    "build": "turbo run build --filter=\"./packages/*\"",
    "build:sdk": "turbo run build --filter=@soroban-resurrect/sdk",
    "build:hook": "turbo run build --filter=@soroban-resurrect/react-hook --filter=@soroban-resurrect/vue-hook --filter=@soroban-resurrect/svelte-hook",
    "dev:example": "npm run dev -w examples/basic",
    "docs:dev": "npm run dev -w docs",
    "docs:build": "npm run build -w docs",
    "docs:preview": "npm run preview -w docs",
    "typecheck": "turbo run typecheck --filter=\"./packages/*\"",
    "typecheck:examples": "npm run typecheck --workspace=examples",
    "lint": "turbo run lint --filter=\"./packages/*\"",
    "lint:fix": "eslint --fix \"packages/*/src/**/*{ts,tsx}\" \"examples/*/src/**/*.{ts,tsx}\"",
    "format": "prettier --check \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .gitignore",
    "test": "turbo run test --filter=\"./packages/*\"",
    "test:root": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:report": "stryker run --reporters html,clear-text,progress",
    "verify": "turbo run verify --filter=\"./packages/*\" --output-logs=errors-only --continue",
    "test:types": "turbo run test:types --filter=\"./packages/*\"",
    "test:watch": "npm run test:watch -w packages/sdk",
    "benchmark:imports": "node scripts/benchmark-imports.mjs",
    "benchmark:imports:update": "node scripts/benchmark-imports.mjs --update",
    "clean": "turbo run clean --filter=\"./packages/*\"",
    "prepare": "husky",
    "verify:pins": "node scripts/verify-workspace-pins.mjs",
    "verify:packaging": "node scripts/verify-packaging.mjs",
    "publish:packages": "node scripts/publish-packages.mjs --provenance",
    "release": "npm run verify:pins && npm run build && npm run verify:packaging && node scripts/publish-packages.mjs --provenance",
    "release:recover": "node scripts/publish-packages.mjs --provenance --resume"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "undici": "^7.29.0",
    "nanoid": "^3.3.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
