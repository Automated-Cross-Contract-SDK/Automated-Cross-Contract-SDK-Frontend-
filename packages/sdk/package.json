{
  "name": "@soroban-resurrect/sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Automated-Cross-Contract-SDK/Automated-Cross-Contract-SDK-Frontend-.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public",
