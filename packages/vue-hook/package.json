{
  "name": "@soroban-resurrect/vue-hook",
  "version": "0.2.0",
  "keywords": [
    "soroban",
    "stellar",
    "cap-0066",
    "ttl",
    "restore",
    "smart-contracts",
    "wallet",
    "vue",
    "vue3",
    "composable"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Automated-Cross-Contract-SDK/Automated-Cross-Contract-SDK-Frontend-.git",
    "directory": "packages/vue-hook"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./composable": {
      "import": "./dist/composable.js",
      "types": "./dist/composable.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:types": "vitest run --typecheck --typecheck.only",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@soroban-resurrect/sdk": "^0.1.0"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vue": "^3.5.43"
  }
}
