    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@soroban-resurrect/sdk": "^0.1.0"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "svelte": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
