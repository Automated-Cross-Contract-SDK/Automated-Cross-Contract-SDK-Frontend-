{
  "name": "@soroban-resurrect/adapter-freighter",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "soroban",
    "stellar",
    "cap-0066",
    "ttl",
    "restore",
    "smart-contracts",
    "wallet",
    "wallet-adapter",
    "freighter"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:types": "vitest run --typecheck --typecheck.only",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stellar/freighter-api": "^3.0.0"
  },
  "peerDependencies": {
    "@soroban-resurrect/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
