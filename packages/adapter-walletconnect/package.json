{
  "name": "@soroban-resurrect/adapter-walletconnect",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "soroban",
    "stellar",
    "cap-0066",
    "ttl",
    "restore",
    "smart-contracts",
    "wallet",
    "wallet-adapter",
    "walletconnect"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:types": "vitest run --typecheck --typecheck.only"
  },
  "peerDependencies": {
    "@soroban-resurrect/sdk": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@walletconnect/sign-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "@soroban-resurrect/sdk": "0.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Automated-Cross-Contract-SDK/Automated-Cross-Contract-SDK-Frontend-.git",
    "directory": "packages/adapter-walletconnect"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
