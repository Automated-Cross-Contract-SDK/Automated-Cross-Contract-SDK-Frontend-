# Soroban RPC endpoint and network (defaults: testnet)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Contract to keep alive
CONTRACT_ID=
# Secret key (S...) of a dedicated, low-balance fee-payer account. NEVER commit a real value.
WORKER_SECRET_KEY=
# Scan interval in seconds (ignored with --once)
SCAN_INTERVAL_SECONDS=3600
# Restore entries whose TTL is at or below this many ledgers (~17280 ledgers/day)
EXPIRING_WITHIN_LEDGERS=17280
